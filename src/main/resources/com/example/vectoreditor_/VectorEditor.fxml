<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ColorPicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="423.0" prefWidth="584.0" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.vectoreditor_.VectorController">
        <HBox spacing="8" style="-fx-padding: 8;">

            <Button onAction="#PointBtnClick" prefHeight="30.0" prefWidth="72.0" text="Point">
         <font>
            <Font size="14.0" />
         </font></Button>
            <Button onAction="#ChooseBtnClick" prefHeight="30.0" prefWidth="90.0" text="Choose">
         <font>
            <Font size="14.0" />
         </font></Button>
            <Button onAction="#NewShapeBtnClick" prefHeight="30.0" prefWidth="106.0" text="New Shape">
         <font>
            <Font size="14.0" />
         </font></Button>

            <Label prefHeight="20.0" prefWidth="98.0" text="Stroke width:">
         <font>
            <Font size="14.0" />
         </font></Label>
            <TextField fx:id="strokeWidthFld" prefWidth="50" text="5">
         <font>
            <Font size="14.0" />
         </font></TextField>
            <Button onAction="#StrokeBtnClick" prefHeight="30.0" prefWidth="78.0" text="Stroke">
         <font>
            <Font size="14.0" />
         </font></Button>

            <Label prefHeight="20.0" prefWidth="92.0" text="Stroke color:">
         <font>
            <Font size="14.0" />
         </font></Label>
            <ColorPicker fx:id="StrokeColorPicker" />

            <Label prefHeight="20.0" prefWidth="78.0" text="Fill color:">
         <font>
            <Font size="14.0" />
         </font></Label>
            <ColorPicker fx:id="FillColorPicker" prefHeight="26.0" prefWidth="103.0" />
            <Button onAction="#FillBtnClick" prefHeight="26.0" prefWidth="54.0" text="Fill">
         <font>
            <Font size="14.0" />
         </font></Button>
      <Button mnemonicParsing="false" onAction="#ShadeBtnClk" prefHeight="30.0" prefWidth="100.0" text="Add shade">
         <font>
            <Font size="14.0" />
         </font></Button>


            <Button onAction="#saveToFile" prefHeight="26.0" prefWidth="66.0" text="Save">
         <font>
            <Font size="14.0" />
         </font></Button>
            <Button onAction="#loadFromFile" prefHeight="30.0" prefWidth="75.0" text="Load">
         <font>
            <Font size="14.0" />
         </font></Button>

        </HBox>
        <HBox prefHeight="32.0" prefWidth="1054.0" spacing="8" style="-fx-padding: 8;">
      <children>
         <CheckBox fx:id="PointModeCheckBox" disable="true" mnemonicParsing="false" text="PointMode">
            <font>
               <Font size="14.0" />
            </font>
         </CheckBox>
         <CheckBox fx:id="ChooseModeCheckBox" disable="true" mnemonicParsing="false" text="ChooseMode">
            <font>
               <Font size="14.0" />
            </font>
         </CheckBox>
         <CheckBox fx:id="NewShapeCheckBox" disable="true" mnemonicParsing="false" text="NewShape">
            <font>
               <Font size="14.0" />
            </font>
         </CheckBox>
         <CheckBox fx:id="MoveModeCheckBox" disable="true" mnemonicParsing="false" text="MoveMode">
            <font>
               <Font size="14.0" />
            </font>
         </CheckBox>
         <Button onAction="#MoveBtnClk" text="Move">
            <font>
               <Font size="14.0" />
            </font>
         </Button>
         <Button onAction="#DeleteBtnClk" text="Delete">
            <font>
               <Font size="14.0" />
            </font>
         </Button>
      </children></HBox>
    <Canvas fx:id="canvas" height="600" onMouseDragged="#canvasDragged" onMousePressed="#canvasPressed" width="1054.0" />

    <HBox spacing="8" style="-fx-padding: 8;">
        <Label text="Vertices:" />
        <TextField fx:id="txtField" editable="false" prefWidth="60" />
    </HBox>


</VBox>
