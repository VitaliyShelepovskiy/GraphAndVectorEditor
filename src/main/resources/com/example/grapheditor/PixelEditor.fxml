<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ColorPicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="423.0" prefWidth="584.0" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.grapheditor.PixelEditorController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <Canvas fx:id="canvas" height="333.0" onMouseDragged="#canvasDragged" width="483.0" />
   <HBox prefHeight="0.0" prefWidth="483.0">
      <children>
          <Button onAction="#CircleButtonClick" prefHeight="30.0" prefWidth="58.0" text="Circle">
            <font>
               <Font size="14.0" />
            </font>
         </Button>
         <Button onAction="#SquareButtonClick" text="Square">
            <font>
               <Font size="14.0" />
            </font>
            <HBox.margin>
               <Insets left="10.0" />
            </HBox.margin>
         </Button>
         <Label text="Color:">
            <font>
               <Font size="14.0" />
            </font>
            <HBox.margin>
               <Insets left="10.0" top="4.0" />
            </HBox.margin>
         </Label>
         <ColorPicker fx:id="colorPicker">
            <HBox.margin>
               <Insets left="20.0" />
            </HBox.margin>
            <value>
               <Color red="0.7684210538864136" green="0.019922027364373207" blue="0.032397009432315826" />
            </value>
         </ColorPicker>
         <Label text="Size:">
            <font>
               <Font size="14.0" />
            </font>
            <HBox.margin>
               <Insets left="10.0" top="4.0" />
            </HBox.margin>
         </Label>
         <TextField fx:id="sizeField" prefHeight="30.0" prefWidth="57.0" text="5">
            <font>
               <Font size="14.0" />
            </font>
            <HBox.margin>
               <Insets left="20.0" />
            </HBox.margin>
         </TextField>
         <Button mnemonicParsing="false" onAction="#DeleteButtonClick" text="Delete">
            <HBox.margin>
               <Insets left="10.0" />
            </HBox.margin>
            <font>
               <Font size="14.0" />
            </font>
         </Button>
      </children>
   </HBox>
   <VBox prefHeight="200.0" prefWidth="100.0" />
   <Button onAction="#OpenBtnClk" mnemonicParsing="false" text="Open">
      <font>
         <Font size="14.0" />
      </font>
   </Button>
   <Button onAction="#SaveBtnClk" mnemonicParsing="false" text="Save">
      <font>
         <Font size="14.0" />
      </font>
   </Button>
</VBox>
